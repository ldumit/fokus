{
  "ConnectionStrings": {
    "Database": "Data Source=fokus.db"
  },
  "Google": {
    "ClientId": "<Google Cloud Console → Credentials → OAuth 2.0 Client ID>",
    "ClientSecret": "<Google Cloud Console → Credentials → OAuth 2.0 Client Secret>"
  },
  "Jira": {
    "InstanceUrl": "<https://your-org.atlassian.net>",
