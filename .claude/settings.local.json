{
  "env": {
    "DISABLE_OMC": "true"
  },
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "MultiEdit",
      "Bash",
      "Glob",
      "Grep",
      "LS",
      "WebFetch",
      "WebSearch",
      "TodoWrite",
      "Task",
      "Bash(mkdir -p \"C:/Users/Laurentiu/.claude/.omc\")",
      "Bash(node -e \"const f=require\\('fs'\\),p='C:/Users/Laurentiu/.claude/.omc/hud-config.json';const cfg=f.existsSync\\(p\\)?JSON.parse\\(f.readFileSync\\(p,'utf8'\\)\\):{};cfg.preset='minimal';f.writeFileSync\\(p,JSON.stringify\\(cfg,null,2\\)\\);console.log\\('Written:',JSON.stringify\\(cfg\\)\\)\")",
      "Skill(codex:rescue)"
    ],
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(sudo *)",
      "Bash(git push*)",
      "Bash(docker rm*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact|resume",
        "hooks": [
          {
            "type": "command",
            "command": "echo \"be $CC_AGENT\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo \"be $CC_AGENT\""
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "echo -n \"\""
  }
}
