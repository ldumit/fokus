{
  "env": {
    "DISABLE_OMC": "true"
  },
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "MultiEdit",
      "Bash",
      "Glob",
      "Grep",
      "LS",
      "WebFetch",
      "WebSearch",
      "TodoWrite",
      "Task",
      "Skill",
      "mcp__plugin_oh-my-claudecode_t"
    ],
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(sudo *)",
      "Bash(git push*)",
      "Bash(docker rm*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact|resume",
        "hooks": [
          {
            "type": "command",
            "command": "echo \"be $CC_AGENT\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo \"be $CC_AGENT\""
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "echo -n \"\""
  }
}
