{
    "env": {
        "OMC_SKIP_HOOKS": "keyword-detector"
    },
    "permissions": {
        "allow": [
            "Read",
            "Edit",
            "Write",
            "MultiEdit",
            "Bash",
            "Glob",
            "Grep",
            "LS",
            "WebFetch",
            "WebSearch",
            "TodoWrite",
            "Task",
            "Skill",
            "mcp__plugin_oh-my-claudecode_t",
            "mcp__claude_ai_Atlassian"
        ],
        "deny": [
        ]
    },
    "hooks": {
        "SessionStart": [
            {
                "matcher": "startup|clear|compact|resume",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node .claude/hooks/restore-agent.js"
                    }
                ]
            }
        ],
        "PreToolUse": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "node .claude/hooks/audit-logger.js",
                        "timeout": 10,
                        "async": true
                    }
                ]
            }
        ]
    }
}